rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validText(value, max) { return value is string && value.size() > 0 && value.size() <= max; }

    match /settings/event {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /nominees/{nomineeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /paymentSubmissions/{submissionId} {
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['nomineeId','nomineeName','nomineeImage','category','amount','voteUnits','fullName','phone','email','bank','senderName','paymentReference','status','createdAt']) &&
        validText(request.resource.data.nomineeId, 160) &&
        validText(request.resource.data.nomineeName, 160) &&
        validText(request.resource.data.category, 80) &&
        request.resource.data.amount is number && request.resource.data.amount >= 100 && request.resource.data.amount <= 10000000 &&
        request.resource.data.voteUnits is number && request.resource.data.voteUnits >= 1 && request.resource.data.voteUnits <= 100000 &&
        request.resource.data.amount == request.resource.data.voteUnits * 100 &&
        validText(request.resource.data.fullName, 120) && validText(request.resource.data.phone, 40) &&
        validText(request.resource.data.paymentReference, 120) && request.resource.data.status == 'pending';
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
